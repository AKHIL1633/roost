# Copy to .env.local and adjust for your machine:
#   cp .env.example .env.local

# Base URL of the NestJS backend API (see backend/.env.example for how to run it).
# Defaults to http://localhost:8000 if unset — only needed if your backend
# runs on a different port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public site origin, used to build absolute URLs (OG tags, share links, etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Overrides which property's data loads when the route doesn't already imply
# one. Leave unset to use the app's built-in default property.
# NEXT_PUBLIC_PROPERTY_ID=60765

# Only needed if testing the "Continue with Google" flow against a deployed
# backend instead of localhost.
# NEXT_PUBLIC_GUEST_GOOGLE_AUTH_URL=http://localhost:8000/guest/auth/google
