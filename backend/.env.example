# Copy to backend/.env and fill in for your machine:
#   cp .env.example .env

NODE_ENV=development
PORT=8000

# Postgres connection string. Point this at a local/Docker Postgres instance,
# then run `npx prisma migrate deploy` to apply schema history and
# `npx prisma db seed` for baseline data.
DATABASE_URL=postgresql://roost:roost@localhost:5432/roost

# Required — the app refuses to boot without this (see src/common/env.util.ts).
# Generate one locally, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Mocks S3 (file storage) and Textract (ID OCR) locally instead of calling AWS.
# Leave true unless you have real AWS credentials to wire up.
USE_LOCAL_STORAGE=true

# No local Redis? Leave REDIS_URL unset — RedisModule falls back to an
# in-memory cache automatically.
# REDIS_URL=redis://localhost:6379

# SQS isn't provisioned locally by default. Leave queue URL vars unset (the
# producer no-ops with a warning) and keep consumers off:
SQS_CONSUMERS_ENABLED=false

# Razorpay — get test-mode keys from https://dashboard.razorpay.com (Settings
# > API Keys) if you need the payment flow to actually complete. Without real
# keys, order creation still works but checkout/capture will fail.
RAZORPAY_TEST_API_KEY=
RAZORPAY_TEST_API_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth — leave unset to boot with a mock client id/secret (guest
# auth still works via email/password; "Continue with Google" will not).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/guest/auth/google/callback

FRONTEND_URL=http://localhost:3005
